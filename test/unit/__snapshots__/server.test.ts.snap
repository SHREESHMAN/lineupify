    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "clientId": {
          "type": "string",
        },
        "lastfmApiKey": {
          "type": "string",
        },
        "redirectPort": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
      },
      "type": "object",
    },
    "title": "Save Spotify client ID",
  },
  "status": {
    "annotations": {
      "openWorldHint": true,
      "readOnlyHint": true,
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {},
      "type": "object",
    },
    "title": "Lineupify status",
  },
  "update_playlist": {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "draftId": {
          "type": "string",
        },
        "force": {
          "type": "boolean",
        },
      },
      "required": [
        "draftId",
      ],
      "type": "object",
    },
    "title": "Update Spotify playlist",
  },
}
`;
