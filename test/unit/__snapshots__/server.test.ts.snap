  "refresh_taste": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "allowVersions": {
          "description": "Allow live/remix/edit versions",
          "type": "boolean",
        },
        "bpmRange": {
          "description": "Keep only tracks whose tempo (Deezer) is in this range, e.g. running { min: 160, max: 180 }",
          "properties": {
            "max": {
              "maximum": 300,
              "minimum": 30,
              "type": "integer",
            },
            "min": {
              "maximum": 300,
              "minimum": 30,
              "type": "integer",
            },
          },
          "type": "object",
        },
        "discoveryOnly": {
          "description": "Skip artists already in the user's top or followed artists",
          "type": "boolean",
        },
        "excludeArtists": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "excludeExplicit": {
          "type": "boolean",
        },
        "excludeLibrary": {
          "description": "default true",
          "type": "boolean",
        },
        "excludePlaylists": {
          "description": "Also skip tracks in these playlists",
          "items": {
            "description": "open.spotify.com/playlist link, spotify:playlist: URI, playlist id, a playlist name from your own library, a deezer.com/playlist link, a draft id (d_xxxx), or "library" for your liked songs",
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 6,
          "type": "array",
        },
        "limitArtists": {
          "description": "default 30",
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "maxDurationMin": {
          "description": "Total length cap, e.g. 45 for a commute",
          "maximum": 100000,
          "minimum": 10,
          "type": "integer",
        },
        "maxTracks": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer",
        },
        "name": {
          "maxLength": 100,
          "type": "string",
        },
        "order": {
          "description": "interleave (default, spreads artists), lineup (artist by artist), shuffle, by_day, known_first",
          "enum": [
            "interleave",
            "lineup",
            "shuffle",
            "by_day",
            "known_first",
          ],
          "type": "string",
        },
        "provider": {
          "description": "spotify: needs a connected account, can publish. deezer: no account or login at all, every feature except publishing (export the list instead). Default: spotify when connected, otherwise deezer",
          "enum": [
            "spotify",
            "deezer",
          ],
          "type": "string",
        },
        "public": {
          "type": "boolean",
        },
        "skipCovers": {
          "description": "Drop a song when a more popular artist has the original (e.g. a Motörhead cover of Enter Sandman). Off by default; costs one Deezer lookup per track",
          "type": "boolean",
        },
        "strictBpm": {
          "description": "With bpmRange: also drop tracks with no known tempo",
          "type": "boolean",
        },
        "strictYear": {
          "description": "With yearRange: also drop tracks whose year is unknown or comes from a remaster/compilation",
          "type": "boolean",
        },
        "tracksPerArtist": {
          "description": "Same count for every artist; overrides tracksPerTier. Use 1 for "one song per artist"",
          "maximum": 30,
          "minimum": 0,
          "type": "integer",
        },
        "tracksPerTier": {
          "properties": {
            "headliner": {
              "maximum": 30,
              "minimum": 0,
              "type": "integer",
            },
            "sub": {
              "maximum": 30,
              "minimum": 0,
              "type": "integer",
            },
            "undercard": {
              "maximum": 30,
              "minimum": 0,
              "type": "integer",
            },
          },
          "type": "object",
        },
        "yearRange": {
          "description": "Keep only tracks released in this range, e.g. { from: 1990, to: 1999 }",
          "properties": {
            "from": {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer",
            },
            "to": {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer",
            },
          },
          "type": "object",
        },
      },
      "type": "object",
    },
    "title": "New songs from your favourite artists",
  },
  "search_tracks": {
    "annotations": {
      "openWorldHint": true,
      "readOnlyHint": true,
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "limit": {
          "maximum": 10,
          "minimum": 1,
          "type": "integer",
        },
        "provider": {
          "description": "Match the draft you will add to",
          "enum": [
            "spotify",
            "deezer",
          ],
          "type": "string",
        },
        "query": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "query",
      ],
      "type": "object",
    },
    "title": "Search tracks",
  },
