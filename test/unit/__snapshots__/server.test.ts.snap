  "merge_playlists": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "description": {
          "maxLength": 300,
          "type": "string",
        },
        "excludeExplicit": {
          "type": "boolean",
        },
        "maxTracks": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer",
        },
        "name": {
          "maxLength": 100,
          "type": "string",
        },
        "order": {
          "description": "default lineup (playlist after playlist); interleave or shuffle to mix them",
          "enum": [
            "interleave",
            "lineup",
            "shuffle",
            "by_day",
            "known_first",
          ],
          "type": "string",
        },
        "playlists": {
          "items": {
            "description": "open.spotify.com/playlist link, spotify:playlist: URI, playlist id, a playlist name from your own library, a deezer.com/playlist link, a draft id (d_xxxx), or "library" for your liked songs",
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 6,
          "minItems": 1,
          "type": "array",
        },
        "public": {
          "type": "boolean",
        },
      },
      "required": [
        "playlists",
      ],
      "type": "object",
    },
    "title": "Merge playlists",
  },
